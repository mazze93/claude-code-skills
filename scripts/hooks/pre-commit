#!/usr/bin/env bash
# Marketplace pre-commit. Install: ln -sf ../../scripts/hooks/pre-commit .git/hooks/pre-commit
#
# Two gates, both from real incidents:
#   check_revert          — an installer wrote a pre-consolidation copy over two
#                           SKILL.md files and it nearly got committed as new work
#   validate_marketplace  — a plugin named the same as a skill, caught on the
#                           validator's first run
set -euo pipefail
cd "$(git rev-parse --show-toplevel)"
fail=0
python3 scripts/check_revert.py || fail=1
python3 scripts/validate_marketplace.py || fail=1
python3 scripts/build_marketplace.py --check || fail=1
[ "$fail" = "0" ] || { echo; echo "pre-commit refused. Override once: git commit --no-verify"; exit 1; }
