+    /**
+     * Response properties under which a stored response must never be reused without
+     * successful validation, regardless of age or client tolerance for staleness.
+     * Mirrors the conditions that make `maxAge()` collapse to zero, but kept separate
+     * so that ordinary zero-lifetime responses (`max-age=0`, expired `Expires`,
+     * heuristic zero) remain eligible for client-requested stale reuse.
+     * Reads only fields that `toObject()` serializes.
+     * @returns {boolean} `true` if reuse without revalidation is prohibited.
+     */
+    _prohibitsReuseWithoutRevalidation() {
+        if (!this.storable() || this._rescc['no-cache']) {
+            return true;
+        }
+        if (
+            this._isShared &&
+            this._resHeaders['set-cookie'] &&
+            !this._rescc.public &&
+            !this._rescc.immutable
+        ) {
+            return true;
+        }
+        if (this._isShared && this._rescc['proxy-revalidate']) {
+            return true;
+        }
+        // Any "*" member of Vary (not only a bare "*") fails to match every request.
+        if (
+            this._resHeaders.vary &&
+            this._resHeaders.vary
+                .trim()
+                .split(/\s*,\s*/)
+                .includes('*')
+        ) {
+            return true;
+        }
+        return false;
+    }
+
+    /**
+     * @returns {boolean} `true` if a stale response must not be served (max-stale,
+     * stale-while-revalidate, stale-if-error). A fresh response may still be served
+     * when only `must-revalidate` applies.
+     */
+    _forbidsStaleReuse() {
+        return (
+            this._prohibitsReuseWithoutRevalidation() ||
+            !!this._rescc['must-revalidate']
+        );
+    }
+
